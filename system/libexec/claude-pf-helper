#!/bin/sh
# claude-pf-helper — the ONLY command the kit's sudoers rule lets the desktop user run as root.
# Every subcommand is a fixed, argument-checked wrapper: the caller can only name one of the kit's three anchors or
# hand over exact host addresses — never a path, an option, a program or free rule text. (A sudoers "*" also matches
# "/" and spaces, so any wildcard rule for install/mv/awk/pfctl was a root shell; free rule text would let any user
# process rewrite the wall.)
# Callers: system/updater/update_shared_ip_wall.py, system/userbin/claude-wall, scripts/mirror_check.py.
set -eu
PATH=/usr/bin:/bin:/usr/sbin:/sbin; export PATH
RULES=/etc/pf.anchors/local.claude-direct-wall
BACKUP_DIR=/var/db/ClaudeDirectWall
LOCK_DIR=/var/run/claude-direct-wall
WATCH_DIR=/var/db/NetGuardWatch

ANCHOR_010=com.apple/010.local.claude-direct-wall
TABLE_010=claude_wall_targets
die() { echo "claude-pf-helper: $*" >&2; exit 64; }
# Only the kit's own three anchors can be read.
anchor_ok() { case "$1" in com.apple/010.local.claude-direct-wall|com.apple/011.local.claude-net-wall|com.apple/020.local.leak-guard) return 0;; esac; return 1; }
name_ok() { case "$1" in ""|-*|*[!A-Za-z0-9_]*) return 1;; esac; return 0; }
# Exact host addresses only (parsed by Python's ipaddress, same as the updater): no prefixes, no names, nothing that
# pfctl would try to resolve, and never loopback / unspecified / multicast / link-local.
ip_ok() {
	case "$1" in ""|-*|*[!0-9A-Fa-f.:]*) return 1;; esac
	/usr/bin/python3 -I -c 'import ipaddress, sys
try:
    a = ipaddress.ip_address(sys.argv[1])
except ValueError:
    sys.exit(1)
sys.exit(1 if (a.is_loopback or a.is_unspecified or a.is_multicast or a.is_link_local) else 0)' "$1" 2>/dev/null
}

cmd=${1:-}
[ $# -gt 0 ] && shift
case "$cmd" in
	info|root-rules|lock|unlock|watch-exists|watch-last|watch-history|profiles)
		[ $# -eq 0 ] || die "${cmd} 不带参数" ;;
	rules|vrules)
		[ $# -eq 1 ] && anchor_ok "$1" || die "用法: ${cmd} <anchor>（只能是本套件的三个 anchor）" ;;
	table)
		[ $# -eq 2 ] && anchor_ok "$1" && name_ok "$2" || die "用法: table <anchor> <table>" ;;
	table-add|persist)
		# Both act only on the direct wall's own table; the caller supplies exact host addresses and nothing else.
		[ $# -ge 1 ] && [ $# -le 128 ] || die "用法: ${cmd} <ip>...（1 到 128 个精确地址）"
		for arg; do ip_ok "$arg" || die "地址不合法（只收精确主机地址，不收网段/主机名）: ${arg}"; done ;;
	kill)
		[ $# -eq 1 ] && ip_ok "$1" || die "用法: kill <ip>（精确主机地址）" ;;
	*)
		die "未知子命令 '${cmd}'（info root-rules rules vrules table table-add kill persist lock unlock watch-exists watch-last watch-history profiles）" ;;
esac
[ "$(id -u)" = 0 ] || die "必须由 root 运行（通过 sudo -n）"

case "$cmd" in
	info)          exec /sbin/pfctl -s info ;;
	root-rules)    exec /sbin/pfctl -sr ;;
	rules)         exec /sbin/pfctl -a "$1" -sr ;;
	vrules)        exec /sbin/pfctl -a "$1" -vsr ;;
	table)         exec /sbin/pfctl -a "$1" -t "$2" -T show ;;
	table-add)     exec /sbin/pfctl -a "$ANCHOR_010" -t "$TABLE_010" -T add "$@" ;;
	kill)          case "$1" in *:*) exec /sbin/pfctl -k '::/0' -k "$1";; *) exec /sbin/pfctl -k '0.0.0.0/0' -k "$1";; esac ;;
	persist)
		# Rewrite ONLY the table line of the live rules file with the given addresses; every other line (the rule
		# body and comments) is copied unchanged, then validated, backed up, staged next to the file and renamed.
		[ -f "$RULES" ] || die "${RULES} 不存在（先装 Claude 直连墙）"
		# Additive only: every address already in the live table line must still be present.
		old_list=$(sed -n "s/^table <${TABLE_010}> persist { \(.*\) }\$/\1/p" "$RULES" | head -1 | tr ',' ' ')
		for o in $old_list; do
			found=0; for ip; do [ "$ip" = "$o" ] && found=1; done
			[ "$found" = 1 ] || die "只增不减：现有地址 ${o} 不在新列表里，不动"
		done
		list=""; for ip; do list="${list}${list:+, }${ip}"; done
		tmp=$(mktemp /tmp/claude-pf-persist.XXXXXX); staging=""
		trap 'rm -f "$tmp" ${staging:+"$staging"}' EXIT
		n=0
		while IFS= read -r line || [ -n "$line" ]; do
			case "$line" in
				"table <${TABLE_010}> persist {"*) printf 'table <%s> persist { %s }\n' "$TABLE_010" "$list" >> "$tmp"; n=$((n+1)) ;;
				*) printf '%s\n' "$line" >> "$tmp" ;;
			esac
		done < "$RULES"
		[ "$n" -eq 1 ] || { rm -f "$tmp"; die "${RULES} 里的 table 声明行不是恰好一条（${n}），不动"; }
		/sbin/pfctl -n -a local.claude-direct-wall -f "$tmp" || { rm -f "$tmp"; die "规则语法没过，没有改动"; }
		[ -d "$BACKUP_DIR" ] || mkdir -m 700 "$BACKUP_DIR"
		install -o root -g wheel -m 600 "$RULES" "$BACKUP_DIR/rules-before-$(date +%Y%m%d-%H%M%S)-$$.pf"
		staging=$(mktemp "$RULES.pending-XXXXXX")
		install -o root -g wheel -m 644 "$tmp" "$staging"
		mv -f "$staging" "$RULES"; staging=""
		echo "persisted $RULES" ;;
	lock)          [ -d "$LOCK_DIR" ] || mkdir -m 700 "$LOCK_DIR"; exec mkdir -m 700 "$LOCK_DIR/update.lock" ;;
	unlock)        exec rmdir "$LOCK_DIR/update.lock" ;;
	watch-exists)  exec test -f "$WATCH_DIR/last" ;;
	watch-last)    exec cat "$WATCH_DIR/last" ;;
	watch-history) exec cat "$WATCH_DIR/history.log" ;;
	profiles)      exec /usr/bin/profiles -P ;;
esac
