<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.claude-direct-wall</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/libexec/claude-direct-wall</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/var/db/ClaudeDirectWall/loader.stderr.log</string>
	<key>StandardOutPath</key>
	<string>/var/db/ClaudeDirectWall/loader.stdout.log</string>
</dict>
</plist>
