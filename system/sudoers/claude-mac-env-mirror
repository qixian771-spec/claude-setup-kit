# claude-mac-env-mirror: let the desktop user run the Claude address updater, claude-wall and the read-only
# checks without a password — only through /usr/local/libexec/claude-pf-helper.
# Installed by installers/lib/install-updater.sh after `visudo -cf` succeeds.
# One root-owned helper with fixed, argument-checked subcommands, and nothing else. A sudoers "*" matches "/" and
# spaces, so any wildcard rule (install/mv/awk, or pfctl with free arguments) could be turned into a root shell.
{{USER}} ALL=(root) NOPASSWD: /usr/local/libexec/claude-pf-helper
